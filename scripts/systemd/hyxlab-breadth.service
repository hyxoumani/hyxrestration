[Unit]
Description=hyxlab exchange-wide top-N breadth snapshots (EXP-928)
[Service]
Type=oneshot
# 110, not 500: OOMScoreAdjust is a per-mille-of-RAM handicap, so on this 60G
# box 500 adds ~30G of pretend footprint and makes this unit outrank essentially
# ANY other process. Measured 2026-09-07, when a 333 MiB poly-sweep was killed
# ahead of the 24.0 GiB stranger that actually exhausted the box. 110 still
# outranks the capture daemons (they inherit the manager's 100) without
# outranking a real hog -- see tests/test_systemd_units.py for the arithmetic.
OOMScoreAdjust=110
WorkingDirectory=/home/devs/workspace/hyxrestration-stable
# collector.breadth is OFF unless switched on. Installing + enabling this
# timer IS the deliberate act; the env var below is what the unit
# contributes, so the code default stays disabled for every ad-hoc run.
Environment=HYXLAB_BREADTH_ENABLED=1
Environment=HYXLAB_BREADTH_TOP_N=1000
# 24h close window => ~9 requests / ~6s per cycle (measured 2026-08-03).
# Widening this is a request-rate decision, not a taste one: unwindowed
# is >200 requests/cycle against a budget shared with the live trader.
Environment=HYXLAB_BREADTH_CLOSE_WINDOW_H=24
# No `flock` wrapper: the writer lock is taken per-burst inside python
# (collector.sweep.writer_burst), so HTTP never runs under it.
ExecStart=/home/devs/workspace/hyxrestration-stable/.venv/bin/python -u -m collector.breadth --once
