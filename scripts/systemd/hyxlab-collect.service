[Unit]
Description=hyxlab 5-min collector (kalshi/poly books + NWS)
[Service]
Type=oneshot
# 220, not 500: OOMScoreAdjust is a per-mille-of-RAM handicap, not a priority
# label, so on this 60G box 500 adds ~30G of pretend footprint and makes this
# unit outrank essentially ANY other process -- measured 2026-09-07, when a
# 333 MiB poly-sweep was killed ahead of the 24.0 GiB stranger that actually
# exhausted the box. The baseline is the manager's DefaultOOMScoreAdjust=200,
# which the capture daemons inherit; 220 is 20 per-mille (~1.2G) above it.
# Measured oom_score: batch 350 MiB @220 = 816 and batch 30 MiB @220 = 813,
# both above live stream/shadow @200 = 803/802 (so batch still dies first, the
# 2026-07-20 intent), while a 1.6G stranger @200 = 817 already outranks them.
# See tests/test_systemd_units.py for the arithmetic.
OOMScoreAdjust=220
# MEASURED 2026-10-11 on a reflink of the 10-09 backup (24.6 GB), the whole
# unit in a transient cgroup, live fetch included. A normal cycle (719 snaps,
# 5,997 markets) succeeds at 512M and is oom-killed at 256M. The sizing case
# is the spool DRAIN: a full spool (MAX_FILES=24 cycles, 162,024 rows) peaks
# at 536-555 MiB anon / 552-574M charged, succeeds at 768M and 1G, and is
# oom-killed at 512M after 7 of 24 files (and at 384M after 1). The drain's
# growth is NOT the buffer pool (flat ~218 MiB at any limit) or the Python
# heap (flat 37 MiB under tracemalloc). It is native allocator fragmentation
# across DuckDB's 24 threads, ~10 MiB/file and decaying (threads=2: 389 MiB,
# MALLOC_ARENA_MAX=2: 500 MiB). It is bounded because MAX_FILES bounds the
# drain. A kill here costs the LIVE cycle, which is fetched but never spooled,
# so the cap must hold the worst drain: 1.5G is 2.8x that anon peak and 2.2x
# the largest charged peak in the journal (681M, uncapped).
MemoryMax=1536M
# The cap's verdict is in the cgroup -- memory.events (max = reclaimed at the
# cap, oom_kill = killed) -- and the cgroup is removed with the unit. The
# journal's `memory peak` is total charge including page cache, == the cap
# for any healthy I/O-heavy run, so it cannot tell reclaim from near-death.
# ExecStopPost runs inside the cgroup after the main process is gone: the
# last reader. Reports only; never fails the unit (scripts/cgmem.sh).
ExecStopPost=/home/devs/workspace/hyxrestration-stable/scripts/cgmem.sh
WorkingDirectory=/home/devs/workspace/hyxrestration-stable
# No `flock -n` wrapper: it dropped the cycle before python started, so the
# hole was invisible to every archive-reading instrument. collector.collect
# waits up to 240s for data/writer.lock and journals a skip if it times out.
ExecStart=/home/devs/workspace/hyxrestration-stable/.venv/bin/python -m collector.collect --once
