[Unit]
Description=hyxlab trade-tape retro-pass (catches sweep's silent HTTPError gaps)
[Service]
Type=oneshot
# 220, not 500: OOMScoreAdjust is a per-mille-of-RAM handicap, not a priority
# label, so on this 60G box 500 adds ~30G of pretend footprint and makes this
# unit outrank essentially ANY other process -- measured 2026-09-07, when a
# 333 MiB poly-sweep was killed ahead of the 24.0 GiB stranger that actually
# exhausted the box. The baseline is the manager's DefaultOOMScoreAdjust=200,
# which the capture daemons inherit; 220 is 20 per-mille (~1.2G) above it.
# Measured oom_score: batch 350 MiB @220 = 816 and batch 30 MiB @220 = 813,
# both above live stream/shadow @200 = 803/802 (so batch still dies first, the
# 2026-07-20 intent), while a 1.6G stranger @200 = 817 already outranks them.
# See tests/test_systemd_units.py for the arithmetic.
OOMScoreAdjust=220
# MEASURED 2026-10-09 on the 10-08 backup (24 GB, 542.8M trades), each of
# the three statements this unit runs in its own process at a pinned DuckDB
# limit: the pending read 0.70G peak RSS at any limit; mark_proven_empty
# 0.89G at 1GB (OutOfMemoryException, cleanly, at 512MB); insert_trades
# 1.13G at 1GB once scoped to its market (aad523d -- unscoped it read the
# whole table, 9-10s and 15.2G per call, which is most of the 28.2G peak
# the 10-09 run recorded). 6G is a 3G DuckDB limit (DUCK_SHARE 0.5), ~2.7x
# the measured floor; the remainder is Python and the page cache that
# memory.max charges and reclaims rather than kills.
MemoryMax=6G
WorkingDirectory=/home/devs/workspace/hyxrestration-stable
ExecStart=/home/devs/workspace/hyxrestration-stable/.venv/bin/python -u -m collector.trades_backfill
