[Unit]
Description=hyxlab collector every 5 min
[Timer]
# `UTC` is load-bearing even on a spec that pins no hour. A suffix-less
# OnCalendar is evaluated in the host's LOCAL zone, and when DST falls back
# the local hour 01:00-02:00 occurs twice; systemd computes the next elapse
# as the next wall-clock instant strictly after the last trigger's, so every
# tick in the repeated hour is "already past". Measured 2026-11-01: this
# timer fired at 06:55:41Z (01:55 CDT) and next at 08:00:00Z (02:00 CST) --
# 12 slots, one hour of snapshots, lost on a healthy box (mistakes #151).
OnCalendar=*:0/5 UTC
Persistent=true
[Install]
WantedBy=timers.target
