[Unit]
Description=hyxlab live stream daemon (kalshi books+trades, poly books)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/devs/workspace/hyxrestration-stable
ExecStart=/home/devs/workspace/hyxrestration-stable/.venv/bin/python -u -m collector.streamd
Restart=always
# 2x collector.streamd.DRAIN_BUDGET_S. The shutdown drain writes buffered
# rows at a measured 7,100/s and systemd SIGKILLs whatever is still running
# when this expires; unset, it was the 90s default, which nothing had
# budgeted against. Pinned here so the deadline the drain sizes itself to is
# a declared constant (tests/test_drain_budget.py).
TimeoutStopSec=180
RestartSec=10
MemoryMax=2G
# The cap's verdict is in the cgroup -- memory.events (max = reclaimed at the
# cap, oom_kill = killed) -- and the cgroup is removed with the unit. The
# journal's `memory peak` is total charge including page cache, == the cap
# for any healthy I/O-heavy run, so it cannot tell reclaim from near-death.
# ExecStopPost runs inside the cgroup after the main process is gone: the
# last reader. Reports only; never fails the unit (scripts/cgmem.sh).
ExecStopPost=/home/devs/workspace/hyxrestration-stable/scripts/cgmem.sh

[Install]
WantedBy=default.target
